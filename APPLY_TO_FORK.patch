@@ -0,0 +1,139 @@
+package com.music.bitchord.ui.player
+
+import androidx.compose.foundation.layout.*
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import com.music.bitchord.data.model.Song
+import com.music.bitchord.playback.chords.ChordEvent
+import com.music.bitchord.playback.chords.chordIndexAt
+import com.music.bitchord.playback.chords.simplifyChordEvents
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+
+/** Analysis implementations own dispatching and caching; playback is never changed. */
+interface ChordAnalysisSource {
+    suspend fun cached(song: Song): List<ChordEvent>?
+    suspend fun analyze(song: Song, onProgress: (Float) -> Unit): List<ChordEvent>
+}
+
+internal class ChordUiState {
+    var events by mutableStateOf<List<ChordEvent>?>(null)
+    var loading by mutableStateOf(true)
+    var progress by mutableFloatStateOf(0f)
+    var error by mutableStateOf<String?>(null)
+    var show by mutableStateOf(true)
+    var simplify by mutableStateOf(false)
+    var positionMs by mutableLongStateOf(0L)
+    var job: Job? = null
+}
+
+@Composable
+internal fun rememberChordState(
+    song: Song, source: ChordAnalysisSource, playhead: LyricPlayhead, active: Boolean,
+): ChordUiState {
+    val state = remember(song, source) { ChordUiState() }
+    DisposableEffect(state) { onDispose { state.job?.cancel() } }
+    LaunchedEffect(state) {
+        try { state.events = source.cached(song) }
+        catch (e: CancellationException) { throw e }
+        catch (_: Exception) { /* A broken cache must not prevent a fresh analysis. */ }
+        finally { state.loading = false }
+    }
+    LaunchedEffect(state, active, playhead) {
+        if (!active) state.job?.cancel()
+        while (active) {
+            state.positionMs = playhead.audioPositionMs
+            delay(100)
+        }
+    }
+    return state
+}
+
+@Composable
+internal fun ChordControls(
+    song: Song, source: ChordAnalysisSource, state: ChordUiState, active: Boolean, synced: Boolean,
+) {
+    val scope = rememberCoroutineScope()
+    if (!active) return
+    Column(Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 4.dp)) {
+        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+            Text("Chords · estimates", color = Color.White.copy(alpha = 0.7f), style = MaterialTheme.typography.labelMedium)
+            if (state.loading) {
+                if (state.job != null) TextButton(onClick = { state.job?.cancel() }) { Text("Cancel") }
+            } else {
+                TextButton(onClick = {
+                    state.loading = true
+                    state.error = null
+                    state.progress = 0f
+                    state.job = scope.launch {
+                        try {
+                            state.events = source.analyze(song) { state.progress = it }
+                            state.show = true
+                        } catch (e: CancellationException) {
+                            throw e
+                        } catch (e: Exception) {
+                            state.error = e.message ?: "Unable to analyse this recording."
+                        } finally { state.loading = false }
+                    }
+                }) { Text(if (state.events == null) "Find chords" else "Analyse again") }
+            }
+        }
+        if (state.loading) LinearProgressIndicator(progress = { state.progress }, modifier = Modifier.fillMaxWidth())
+        state.error?.let { Text(it, color = Color.White.copy(alpha = 0.8f), style = MaterialTheme.typography.bodySmall) }
+        if (state.events != null) {
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                FilterChip(selected = state.show, onClick = { state.show = !state.show }, label = { Text("Show chords") })
+                FilterChip(selected = state.simplify, onClick = { state.simplify = !state.simplify }, label = { Text("Simplify") })
+            }
+            if (state.events!!.isEmpty()) {
+                Text("Not enough audio to estimate chords.", color = Color.White)
+            } else if (!synced && state.show) {
+                // No invented lyric alignment when the lyric provider has no timestamps.
+                Text("Timed lyrics needed to place chords above lines.", color = Color.White.copy(alpha = 0.7f),
+                    style = MaterialTheme.typography.bodySmall)
+                CurrentChord(state)
+            }
+        }
+    }
+}
+
+@Composable
+private fun CurrentChord(state: ChordUiState) {
+    val events = remember(state.events, state.simplify) {
+        if (state.simplify) simplifyChordEvents(state.events.orEmpty()) else state.events.orEmpty()
+    }
+    val current by remember(events, state) { derivedStateOf { chordIndexAt(events, state.positionMs) } }
+    Text("Now: ${events.getOrNull(current)?.label?.takeUnless { it == "N" } ?: "—"}", color = Color.White,
+        style = MaterialTheme.typography.titleMedium)
+}
+
+/** Text above each lyric, with the same row motion as the original and translation. */
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+internal fun LyricChordLine(events: List<ChordEvent>, state: ChordUiState, alignEnd: Boolean, inset: Dp) {
+    val current by remember(events, state) { derivedStateOf { chordIndexAt(events, state.positionMs) } }
+    FlowRow(
+        modifier = Modifier.fillMaxWidth().padding(horizontal = inset).padding(top = 6.dp, bottom = 2.dp),
+        horizontalArrangement = if (alignEnd) Arrangement.spacedBy(14.dp, androidx.compose.ui.Alignment.End)
+            else Arrangement.spacedBy(14.dp),
+        verticalArrangement = Arrangement.spacedBy(4.dp),
+    ) {
+        events.forEachIndexed { index, event ->
+            val selected = current == index
+            Text(
+                text = if (event.label == "N") "—" else event.label,
+                color = Color.White.copy(alpha = if (selected) 1f else 0.5f),
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = if (selected) FontWeight.Bold else FontWeight.Medium,
+                modifier = Modifier.padding(vertical = 2.dp),
+            )
+        }
+    }
+}
