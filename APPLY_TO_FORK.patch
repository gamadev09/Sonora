--- /dev/null
+++ b/shared/src/commonMain/kotlin/com/music/bitchord/playback/chords/ChordAnalysis.kt
@@ -0,0 +1,171 @@
+package com.music.bitchord.playback.chords
+
+import kotlin.math.*
+
+/** Estimated harmony, not a transcription. N means silence or uncertain harmony. */
+data class ChordEvent(val startMs: Long, val endMs: Long, val label: String)
+
+fun chordIndexAt(events: List<ChordEvent>, positionMs: Long): Int {
+    var low = 0
+    var high = events.lastIndex
+    while (low <= high) {
+        val mid = (low + high) ushr 1
+        val event = events[mid]
+        when {
+            positionMs < event.startMs -> high = mid - 1
+            positionMs >= event.endMs -> low = mid + 1
+            else -> return mid
+        }
+    }
+    return -1
+}
+
+/**
+ * Bounded-memory baseline: low-pass/decimate mono PCM, FFT chroma, then major/minor and seventh-chord
+ * templates. No network, weights or native dependencies. Dense mixes, inversions,
+ * detuning and richer extensions need a better detector; the UI contract stays the same.
+ * One instance per recording, fed in presentation-time order from a worker thread.
+ */
+class ChordAnalyzer {
+    private val ring = DoubleArray(SIZE)
+    private val real = DoubleArray(SIZE)
+    private val imaginary = DoubleArray(SIZE)
+    private val window = DoubleArray(SIZE) { 0.5 - 0.5 * cos(2 * PI * it / (SIZE - 1)) }
+    private var written = 0L
+    private var nextFrame = SIZE.toLong()
+    private var phase = 0.0
+    private var sum = 0.0
+    private var count = 0
+    private var originMs: Double? = null
+    private var rate: Int? = null
+    private val frames = mutableListOf<Pair<Long, String>>()
+
+    fun accept(samples: FloatArray, atSeconds: Double, sampleRate: Int) {
+        require(sampleRate >= TARGET_RATE && atSeconds.isFinite())
+        require(rate == null || rate == sampleRate) { "Sample rate changed during analysis" }
+        rate = sampleRate
+        if (originMs == null) originMs = atSeconds * 1000
+        for (sample in samples) {
+            sum += if (sample.isFinite()) sample.toDouble() else 0.0
+            count++
+            phase += TARGET_RATE
+            if (phase >= sampleRate) {
+                phase -= sampleRate
+                ring[(written % SIZE).toInt()] = sum / count
+                sum = 0.0
+                count = 0
+                written++
+                if (written >= nextFrame) {
+                    val centreMs = originMs!! + (written - SIZE / 2) * 1000.0 / TARGET_RATE
+                    frames += centreMs.toLong().coerceAtLeast(0) to classify()
+                    nextFrame += HOP
+                }
+            }
+        }
+    }
+
+    fun finish(durationMs: Long): List<ChordEvent> {
+        if (frames.isEmpty() || durationMs <= 0) return emptyList()
+        // A three-frame majority suppresses isolated changes without shifting timestamps.
+        val smooth = frames.indices.map { i ->
+            val nearby = frames.subList(max(0, i - 1), min(frames.size, i + 2)).map { it.second }
+            nearby.groupingBy { it }.eachCount().maxByOrNull { it.value }
+                ?.takeIf { it.value >= 2 }?.key ?: frames[i].second
+        }
+        val events = mutableListOf<ChordEvent>()
+        var label = smooth.first()
+        var start = 0L
+        for (i in 1 until frames.size) {
+            if (smooth[i] == label) continue
+            val boundary = ((frames[i - 1].first + frames[i].first) / 2).coerceIn(start, durationMs)
+            if (boundary > start) events += ChordEvent(start, boundary, label)
+            start = boundary
+            label = smooth[i]
+        }
+        if (start < durationMs) events += ChordEvent(start, durationMs, label)
+        return events
+    }
+
+    private fun classify(): String {
+        var energy = 0.0
+        for (i in 0 until SIZE) {
+            val sample = ring[((written + i) % SIZE).toInt()]
+            energy += sample * sample
+            real[i] = sample * window[i]
+            imaginary[i] = 0.0
+        }
+        if (energy / SIZE < 1e-7) return "N"
+        fft()
+        val chroma = DoubleArray(12)
+        for (bin in 1 until SIZE / 2) {
+            val frequency = bin.toDouble() * TARGET_RATE / SIZE
+            if (frequency < 65 || frequency > 1600) continue
+            val midi = 69 + 12 * ln(frequency / 440) / ln(2.0)
+            val note = midi.roundToInt()
+            val distance = abs(midi - note)
+            if (distance > 0.4) continue
+            val magnitude = sqrt(real[bin] * real[bin] + imaginary[bin] * imaginary[bin])
+            chroma[((note % 12) + 12) % 12] += magnitude * (1 - distance / 0.5)
+        }
+        val norm = sqrt(chroma.sumOf { it * it })
+        if (norm < 1e-9) return "N"
+        var best = -1.0
+        var second = -1.0
+        var winner = "N"
+        for (root in 0..11) for ((suffix, intervals) in TEMPLATES) {
+            val score = intervals.sumOf { chroma[(root + it) % 12] } / (norm * sqrt(intervals.size.toDouble()))
+            if (score > best) {
+                second = best
+                best = score
+                winner = NAMES[root] + suffix
+            } else if (score > second) second = score
+        }
+        return if (best < 0.65 || best - second < 0.025) "N" else winner
+    }
+
+    private fun fft() {
+        var j = 0
+        for (i in 1 until SIZE) {
+            var bit = SIZE shr 1
+            while (j and bit != 0) { j = j xor bit; bit = bit shr 1 }
+            j = j xor bit
+            if (i < j) { val t = real[i]; real[i] = real[j]; real[j] = t }
+        }
+        var length = 2
+        while (length <= SIZE) {
+            val angle = -2 * PI / length
+            val stepR = cos(angle)
+            val stepI = sin(angle)
+            for (start in 0 until SIZE step length) {
+                var wr = 1.0
+                var wi = 0.0
+                for (k in 0 until length / 2) {
+                    val a = start + k
+                    val b = a + length / 2
+                    val br = real[b] * wr - imaginary[b] * wi
+                    val bi = real[b] * wi + imaginary[b] * wr
+                    real[b] = real[a] - br
+                    imaginary[b] = imaginary[a] - bi
+                    real[a] += br
+                    imaginary[a] += bi
+                    val nextR = wr * stepR - wi * stepI
+                    wi = wr * stepI + wi * stepR
+                    wr = nextR
+                }
+            }
+            length *= 2
+        }
+    }
+
+    companion object {
+        const val VERSION = 2
+        private const val TARGET_RATE = 11025
+        private const val SIZE = 8192
+        private const val HOP = 2756
+        private val NAMES = listOf("C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B")
+        private val TEMPLATES = listOf(
+            "" to listOf(0, 4, 7), "m" to listOf(0, 3, 7),
+            "7" to listOf(0, 4, 7, 10), "maj7" to listOf(0, 4, 7, 11), "m7" to listOf(0, 3, 7, 10),
+        )
+    }
+}
